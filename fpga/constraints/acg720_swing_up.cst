// ACG720-138K + IP570 自动起摆工程管脚约束
// 自制板 P7 前 8 个信号依次接 ACG720 的 GPIO0_0 ~ GPIO0_7。
// 5V、3V3、GND 只接电源端，绝不接 FPGA GPIO。

// 50MHz 有源晶振
IO_LOC "clk_50m" Y18;
IO_PORT "clk_50m" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// S4：第四方案测试，低有效；本工程没有外部复位键
IO_LOC "key_test_n[3]" B21;
IO_PORT "key_test_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// S0：停止并锁存；S1：第一方案测试，均为低有效
IO_LOC "key_stop_n" F15;
IO_PORT "key_stop_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "key_test_n[0]" A20;
IO_PORT "key_test_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// 电机霍尔编码器，自制板上已经由 5V 电平转换到 3.3V
// ENC_A -> GPIO0_0，ENC_B -> GPIO0_1
IO_LOC "enc_a" A13;
IO_PORT "enc_a" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_b" A14;
IO_PORT "enc_b" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// TB6612FNG：PWM -> GPIO0_2，AIN1 -> GPIO0_3，AIN2 -> GPIO0_4，STBY -> GPIO0_5
IO_LOC "motor_pwm" A15;
IO_PORT "motor_pwm" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_ain1" A16;
IO_PORT "motor_ain1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_ain2" A18;
IO_PORT "motor_ain2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_stby" A19;
IO_PORT "motor_stby" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ADS1115 I2C：SDA -> GPIO0_6，SCL -> GPIO0_7
IO_LOC "i2c_sda" F13;
IO_PORT "i2c_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "i2c_scl" F14;
IO_PORT "i2c_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// USB 转串口：当前遥测只使用 FPGA TX
IO_LOC "uart_tx" M15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ACG720 板载 LED0~LED3，高电平点亮
IO_LOC "led[0]" M22;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[1]" N22;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[2]" L21;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led[3]" K21;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// S2、S3：第二、第三方案测试，低有效
IO_LOC "key_test_n[1]" B20;
IO_PORT "key_test_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "key_test_n[2]" A21;
IO_PORT "key_test_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// WEXD: 8 位拨码全部启用（SW0~SW7），低有效（ON=0，代码里取反成 1）
IO_LOC "sw_n[0]" G22;
IO_PORT "sw_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "sw_n[1]" D22;
IO_PORT "sw_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "sw_n[2]" E22;
IO_PORT "sw_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "sw_n[3]" G21;
IO_PORT "sw_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "sw_n[4]" E21;
IO_PORT "sw_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "sw_n[5]" D21;
IO_PORT "sw_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "sw_n[6]" C22;
IO_PORT "sw_n[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "sw_n[7]" B22;
IO_PORT "sw_n[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ACG720 schematic page1: FPGA_UART_RX=J21 (CH340E TXD).
IO_LOC "uart_rx" J21;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
